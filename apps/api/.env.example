# apps/api 환경변수 예시
# ✅ 이 파일(.env.example)은 git에 커밋합니다 — 실제 시크릿 절대 금지
#
# 로컬 개발:  필요 시 .env.local 파일을 생성하고 아래 값을 재정의하세요
# 배포 환경:  플랫폼의 환경변수 설정에서 직접 주입하세요 (선택사항)
#
# ✅ TOUR_API_BASE_URL 과 TOUR_API_SERVICE_KEY 는 builtins.ts 에 내장되어 있어
#    .env 파일 없이도 동작합니다. 환경변수가 있으면 내장값보다 우선 적용됩니다.

# ── TourAPI (한국관광공사 공공데이터포털) ─────────────────────────────────
# 아래 두 값은 내장값이 있으므로 생략 가능합니다
# TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
# TOUR_API_SERVICE_KEY=<your-key>

# MobileOS / MobileApp 은 미설정 시 ETC / GozneokLite 로 동작
# TOUR_API_MOBILE_OS=ETC
# TOUR_API_MOBILE_APP=GozneokLite

# ── 서버 설정 ─────────────────────────────────────────────────────────────
# 기본값: 3001
# PORT=3001

# ── 더미 데이터 모드 ──────────────────────────────────────────────────────
# true 이면 TourAPI 호출 없이 더미 데이터 반환 (기본: false)
# USE_DUMMY_DATA=false

# ── CORS ─────────────────────────────────────────────────────────────────
# 허용할 프론트 오리진 (공백 또는 쉼표 구분)
# 기본값: localhost + 두 Toss 프로덕션 호스트
# CORS_ORIGINS=http://localhost:5173,https://gozneok-lite.apps.tossmini.com,https://gozneok-lite.private-apps.tossmini.com

