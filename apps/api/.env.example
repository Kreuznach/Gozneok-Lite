# apps/api 환경변수 예시
# ✅ 이 파일(.env.example)은 git에 커밋합니다 — 실제 시크릿 절대 금지
#
# 로컬 개발:  .env.local 파일을 생성하고 아래 값을 채워넣으세요
# 배포 환경:  플랫폼(Fly.io, Railway, Toss MiniApp 등)의 환경변수 설정에서 직접 주입하세요
#
# ⚠️  TOUR_API_SERVICE_KEY 가 없으면 서버가 자동으로 더미 데이터 모드로 실행됩니다.
#     검색 결과가 나오지 않을 경우 이 값을 확인하세요.

# ── TourAPI (한국관광공사 공공데이터포털) ─────────────────────────────────
# 기본값이 코드에 내장되어 있어 아래 항목은 생략 가능합니다
TOUR_API_BASE_URL=https://apis.data.go.kr/B551011/KorService2
TOUR_API_MOBILE_OS=ETC
TOUR_API_MOBILE_APP=GozneokLite

# 공공데이터포털 https://www.data.go.kr 에서 발급 — 절대 커밋 금지
TOUR_API_SERVICE_KEY=__PUT_YOUR_KEY_HERE__

# ── 서버 설정 ─────────────────────────────────────────────────────────────
# 기본값: 3001
PORT=3001

# ── 더미 데이터 모드 ──────────────────────────────────────────────────────
# true 이면 TourAPI 호출 없이 더미 데이터 반환 (TOUR_API_SERVICE_KEY 미설정 시 자동 활성화)
USE_DUMMY_DATA=false

# ── CORS ─────────────────────────────────────────────────────────────────
# 허용할 프론트 오리진 (공백 또는 쉼표로 구분, 기본값: http://localhost:5173)
CORS_ORIGINS=http://localhost:5173
