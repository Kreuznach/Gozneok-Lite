# apps/web 환경변수 예시
# 이 파일은 커밋 가능합니다. 실제 키/시크릿은 절대 여기에 넣지 마세요.

# 프록시 API 기본 URL
# 로컬 개발: vite proxy를 통해 /api → http://localhost:3001 자동 전달되므로 생략 가능
# 프로덕션: 실제 API 서버 URL로 교체
VITE_API_BASE_URL=

# Apps in Toss AdMob 광고 그룹 ID (Toss 파트너 콘솔에서 발급)
# 미설정 시 광고가 표시되지 않습니다 (앱은 정상 동작)
VITE_ADMOB_INTERSTITIAL_GROUP_ID=
VITE_ADMOB_REWARDED_GROUP_ID=
