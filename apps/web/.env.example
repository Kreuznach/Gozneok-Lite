# apps/web 환경변수 예시
# 이 파일은 커밋 가능합니다. 실제 키/시크릿은 절대 여기에 넣지 마세요.

# 프록시 API 기본 URL
# 로컬 개발: vite proxy를 통해 /api → http://localhost:3001 자동 전달되므로 생략 가능
# 프로덕션(Toss WebView 포함): 실제 API 서버 URL로 반드시 교체
# ⚠️ Toss 미니앱 테스트/배포 빌드 시 미설정이면 API 호출이 실패합니다
VITE_API_BASE_URL=

# Apps in Toss AdMob 광고 그룹 ID (Toss 파트너 콘솔에서 발급)
# 미설정 시 광고가 표시되지 않습니다 (앱은 정상 동작)
#
# 배너(피드형·native image) 광고 ID
#   TEST 환경 기본값: ait-ad-test-native-image-id
#   LIVE 환경 기본값: ait.v2.live.cc42e4d2cbf54b8d
#   아래 변수를 명시하면 환경에 무관하게 해당 값이 우선 적용됩니다.
VITE_ADMOB_BANNER_GROUP_ID=
VITE_ADMOB_INTERSTITIAL_GROUP_ID=
VITE_ADMOB_REWARDED_GROUP_ID=
