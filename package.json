{
  "name": "gozneok-lite",
  "version": "0.1.3",
  "private": true,
  "description": "고요한 산책 (Quiet Walk) - 조용한 장소 추천 미니앱 (Apps in Toss WebView)",
  "packageManager": "pnpm@8.15.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm -r --parallel run dev",
    "dev:web": "pnpm --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "build": "pnpm -r run build",
    "build:web": "pnpm --filter web build",
    "build:api": "pnpm --filter api build",
    "build:ait": "npm run build --prefix apps/web && npx ait build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck"
  },
  "dependencies": {
    "@apps-in-toss/web-framework": "^2.1.1",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-router-dom": "^6.22.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.4.5",
    "vite": "^5.2.12"
  }
}
